source "https://rubygems.org"

# Documentation generator and locally installed theme.
gem "jekyll", "~> 4.3"
gem "just-the-docs", "~> 0.12"

# SEO and content plugins
gem "jekyll-feed", "~> 0.15"
gem "jekyll-sitemap", "~> 1.4"
gem "jekyll-seo-tag", "~> 2.8"
gem "json", ">= 2.21.2"

# Security overrides for vulnerable transitive dependencies.
gem "activesupport", ">= 8.1.2.1"
gem "addressable", ">= 2.9.0"
gem "concurrent-ruby", ">= 1.3.7"
gem "faraday", ">= 2.14.3"
gem "nokogiri", ">= 1.19.4"

# Ruby 3.0+ compatibility
gem "webrick", "~> 1.8"

# Platform-specific dependencies
# Windows and JRuby does not include zoneinfo files, so bundle the tzinfo-data gem
# and associated library.
platforms :windows, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

# Performance optimization for Windows
gem "wdm", "~> 0.1.1", :platforms => [:windows]

# JRuby compatibility - lock to v0.6.x as newer versions lack Java counterpart
gem "http_parser.rb", "~> 0.6.0", :platforms => [:jruby]
